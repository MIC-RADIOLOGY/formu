# Copy this file to .env and fill in your own keys.
# .env is gitignored - never commit real keys.

# The Odds API (https://the-odds-api.com) - free tier, no card required
# Used client-side (VITE_ prefix = bundled into the browser build).
VITE_ODDS_API_KEY=

# football-data.org (https://www.football-data.org) - free tier, no card required
# Used SERVER-SIDE ONLY (no VITE_ prefix, so it's never bundled into client
# JS). Read by vite.config.js in dev, and by Netlify's environment variables
# in production (set it in Site settings -> Environment variables, not here).
FOOTBALL_DATA_API_KEY=

# Supabase project settings (Project Settings -> API in your Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
